---
// Override of Starlight's header SocialIcons: show the current d3gl version to
// the left of the social icons (GitHub), then render Starlight's default icons.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import pkg from "../../../packages/d3gl/package.json";
---

<a
  class="d3gl-version"
  href={`https://www.npmjs.com/package/@mapequation/d3gl/v/${pkg.version}`}
  target="_blank"
  rel="noopener noreferrer"
  title={`@mapequation/d3gl v${pkg.version} on npm`}
>
  <svg
    class="d3gl-version__npm"
    viewBox="0 0 24 24"
    width="16"
    height="16"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"
    ></path>
  </svg>
  <span>v{pkg.version}</span>
</a>
<Default><slot /></Default>
