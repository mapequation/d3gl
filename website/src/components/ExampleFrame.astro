---
import CodeTabs from "./CodeTabs.astro";
import type { ControlSpec } from "../examples/types.js";

interface Props { id: string; controls?: ControlSpec[]; files: string[]; width?: number; height?: number; defaults?: Record<string, unknown> }
const { id, controls = [], files, width = 900, height = 560, defaults = {} } = Astro.props;

// All example sources as raw strings, resolved at build time.
const raw = import.meta.glob("../examples/**/*.ts", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const tabs = files.map((f) => ({
  name: f.split("/").pop()!,
  code: raw[`../examples/${f}`] ?? `// missing: ${f}`,
  lang: "ts",
}));
---
<div class="d3gl-example my-6 overflow-hidden rounded-lg border border-[var(--sl-color-gray-5)]" data-example={id} data-controls={JSON.stringify(controls)} data-defaults={JSON.stringify(defaults)}>
  <div class="flex flex-wrap items-center gap-2.5 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-2.5 py-2 text-[13px]" data-status-bar></div>
  <div class="flex flex-wrap items-center gap-2.5 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-2.5 py-2 text-[13px] empty:hidden" data-controls-row></div>
  <div class="d3gl-canvas relative max-w-full overflow-auto bg-white" data-canvas style={`width:${width}px;height:${height}px`}></div>
  <CodeTabs files={tabs} />
</div>
<script>
  import { setupExample } from "./example-runtime.ts";
  document.querySelectorAll<HTMLElement>(".d3gl-example").forEach((el) => { setupExample(el); });
</script>
