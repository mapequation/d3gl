{
  "name": "d3gl-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @d3gl/website dev",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter @mapequation/d3gl build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:lib && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "playwright": "^1.60.0",
    "tsup": "^8.3.5",
    "typescript": "^5.4.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
